PORT=3000

# Recipient Email for Contact Form Inquiries
NOTIFICATION_EMAIL=lunaticlavish357@gmail.com

# SMTP Email Configuration (Optional - for live email delivery via Gmail/Outlook)
# To use Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an "App password" (16 characters)
# 4. Fill in EMAIL_USER and EMAIL_PASS below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Sender display name
EMAIL_FROM_NAME="Lawish Kumar Portfolio"
